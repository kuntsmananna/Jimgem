# Copy to .env.local and fill in real values. .env.local is git-ignored.

# Base64-encoded contents of a Google Service Account JSON key file.
# e.g. `base64 -w0 service-account.json` (Linux) or `base64 -i service-account.json` (macOS)
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Default spreadsheet ID/range used by /api/sheets when not passed as query params.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_DEFAULT_RANGE=

# Postgres connection string (Vercel Postgres or Neon).
DATABASE_URL=

# Random 32+ char secret used to encrypt the session cookie, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# SUMIT (financial services — invoicing, charging, expenses).
# Company ID and API key from SUMIT's own developers/API settings page.
# Read-only so far: see scripts/sumit-probe.mts.
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
